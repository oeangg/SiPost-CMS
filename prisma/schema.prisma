generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum kategoriPlatform {
  FACEBOOK
  INSTAGRAM
  THREADS
  TIKTOK
  WEBSITE
  X
  YOUTUBE
  LAINNYA
}

enum kategoriAfiliate {
  LAZADA
  TOKOPEDIA
  TIKTOK_SHOP
  SHOPEE
  LAINNYA
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum UserRole {
  SUPER_ADMIN
  SUPERVISOR
  ADMIN
}

model User {
  id                    String                @id
  name                  String
  email                 String                @unique
  emailVerified         Boolean               @default(false)
  image                 String?
  role                  UserRole              @default(ADMIN)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sessions              Session[]
  accounts              Account[]
  contentPosts          ContentPost[]
  categoryContents      CategoryContent[]
  afiliateDailySumaries AfiliateDailySumary[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model ContentPost {
  id           String   @id @default(cuid())
  body         String?
  hook         String?
  cta          String?
  affiliateUrl String?
  mediaUrls    String[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId   String
  categoryName CategoryContent @relation(fields: [categoryId], references: [id])

  platform      kategoriPlatform
  affiliateType kategoriAfiliate?
  status        PostStatus        @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  metrics       PostMetric[]

  @@index([userId])
  @@index([categoryId])
}

model CategoryContent {
  id           String @id @default(cuid())
  categoryName String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentPosts ContentPost[]

  @@unique([userId, categoryName])
  @@index([userId])
}

model PostMetric {
  id                    String               @id @default(cuid())
  contentPostId         String
  contentPost           ContentPost          @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  afiliateDailySumaryId String?
  afiliateDailySumary   AfiliateDailySumary? @relation(fields: [afiliateDailySumaryId], references: [id], onDelete: SetNull)
  metricDate            DateTime
  views                 Int                  @default(0)
  likes                 Int                  @default(0)
  comments              Int                  @default(0)
  shares                Int                  @default(0)
  repost                Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([contentPostId, metricDate])
  @@index([afiliateDailySumaryId])
}

model AfiliateDailySumary {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  summaryDate   DateTime
  affiliateType kategoriAfiliate @default(SHOPEE)
  totalClicks   Int              @default(0)
  totalOrders   Int              @default(0)
  totalRevenue  Decimal          @default(0) @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  metrics       PostMetric[]

  @@unique([userId, summaryDate, affiliateType])
  @@index([userId])
}
